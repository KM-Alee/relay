{
  "name": "@relay/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./*": "./src/*.ts",
    "./seed": "./seed/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "tsx scripts/migrate.ts",
    "reset": "tsx scripts/reset.ts",
    "generate": "drizzle-kit generate",
    "seed": "tsx scripts/seed.ts",
    "new-migration": "tsx scripts/new-migration.ts",
    "drop-worktree-dbs": "tsx scripts/drop-worktree-dbs.ts"
  },
  "dependencies": {
    "@relay/contracts": "workspace:*",
    "@vercel/functions": "3.10.1",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
