# Canonical env list. Validated by packages/core/src/config.ts (one Zod section per lane; parsed lazily,
# `validateConfig(['core','db'])` runs at server boot from apps/web/instrumentation.ts). Empty = unset.
# Copy to apps/web/.env.local for local dev (or: vercel env pull apps/web/.env.local).
# NEVER commit real values. Docs: docs/12-demo-and-ops.md §2

# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
APP_ENCRYPTION_KEY=            # 32 random bytes, base64 (openssl rand -base64 32)
APP_ENCRYPTION_KEY_PREVIOUS=   # optional, for key rotation
SESSION_SECRET=                # 32+ random bytes, base64 (CSRF token signing)
DEMO_MODE=true                 # enables Judge Console, time-warp, traceability re-run

# ── Database (Neon in prod/preview, Docker locally) ────────────────────
# Runtime: POOLED url, role app_user (NOBYPASSRLS). Never the owner role.
DATABASE_URL=postgres://app_user:app_user_dev@localhost:5432/relay
# Local docker only: app_user's LOGIN password is created by docker/postgres/init/01-relay.sql and
# re-set by the roles migration from APP_DB_PASSWORD.
# Migrations only: UNPOOLED url, owner role.
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:5432/relay
APP_DB_PASSWORD=app_user_dev   # password the roles migration sets for app_user
TEST_DATABASE_URL=postgres://app_user:app_user_dev@localhost:5432/relay_test
TEST_DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:5432/relay_test
# Integration tests create TEST_DATABASE_URL's database if missing and migrate it (per-worktree DBs).
# ALLOW_REMOTE_TEST_DB=1       # only for the daily Neon CI run (tests refuse non-local hosts otherwise)

# ── Jobs / timers (docs/01-architecture.md §6) ─────────────────────────
QSTASH_TOKEN=
QSTASH_URL=                    # region-specific QStash API URL from the Upstash console (empty = SDK default)
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
CRON_SECRET=                   # Bearer token for manual /api/internal/tick calls (QStash calls are signature-verified)
TICK_BUDGET_MS=20000

# ── Storage ────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── WhatsApp: Meta Cloud API (platform default; workspaces may override) ─
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=             # prefer a System User permanent token
META_GRAPH_VERSION=v25.0        # verified 2026-10-18 (latest v26.0)
WHATSAPP_DEFAULT_WORKSPACE_SLUG=  # workspace for the platform-default number (else oldest demo workspace)
WHATSAPP_TEST_RECIPIENTS=         # comma-separated E.164 numbers for scripts/whatsapp-smoke.ts

# ── Stripe (TEST MODE ONLY) ────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# ── Google Calendar OAuth (app in Testing status) ──────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# ── Slack (ADR-0011; `pnpm slack:manifest` prints the app manifest) ───
SLACK_BOT_TOKEN=               # xoxb-… bot token
SLACK_SIGNING_SECRET=          # verifies /api/webhooks/slack/* requests (raw body)
SLACK_APP_ID=
SLACK_TEAM_ID=                 # optional: restrict the app to one Slack workspace

# ── OpenAI (only paid dependency) ──────────────────────────────────────
AI_ENABLED=true                # false (the default when unset) → every AI task returns 'disabled'; app fully works.
                               # true requires OPENAI_API_KEY unless INTEGRATIONS_FAKE=1
OPENAI_API_KEY=
OPENAI_MODEL_CHAT=             # cheapest suitable small chat model — verify at build time
OPENAI_MODEL_TRIAGE=           # may equal OPENAI_MODEL_CHAT
OPENAI_MODEL_TRANSCRIBE=       # cheapest transcription model with acceptable Urdu — verify
AI_DEFAULT_DAILY_COST_CAP_USD=2

# ── Testing / CI / traceability ────────────────────────────────────────
INTEGRATIONS_FAKE=0            # 1 = fake adapters (tests/local only; refused in production)
GITHUB_TOKEN=                  # fine-grained PAT, actions:write (traceability re-run)
GITHUB_REPO=                   # owner/name
GITHUB_REF=main
TEST_RESULTS_URL=              # https://<prod>/api/internal/test-results
TEST_RESULTS_SECRET=
