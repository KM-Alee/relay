{
  "name": "relay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @relay/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e": "playwright test",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @relay/db migrate",
    "db:generate": "pnpm --filter @relay/db generate",
    "db:reset": "pnpm --filter @relay/db reset",
    "db:seed": "pnpm --filter @relay/db seed",
    "db:new": "pnpm --silent --filter @relay/db new-migration",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.2",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,css,yml,yaml}": "prettier --write --ignore-unknown"
  }
}
