{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm check:*)",
      "Bash(pnpm traceability:*)",
      "Bash(pnpm format:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./apps/web/.env.local)",
      "Read(./apps/web/.env.production*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && echo '--- STATUS.md (head) ---' && head -n 14 STATUS.md && echo '--- Read AGENTS.md before changing code. Design system: docs/design/ (Warm Orange). Parallel playbook: docs/13-parallel-development.md ---'"
          }
        ]
      }
    ]
  }
}
